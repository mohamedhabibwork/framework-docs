---
/**
 * `SiteTitle` component override: renders the site title followed by a small
 * docs-version pill linking to the versions page. This is the sanctioned
 * Starlight header slot chosen over a `ThemeSelect` override (which would
 * require reimplementing the theme switcher) — see astro.config.mjs.
 */
import { docsVersions, formatLine } from '../data/versions';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const version = formatLine(docsVersions.latest);
---

<a href={siteTitleHref} class="site-title sl-flex" translate="no">
	<span>{siteTitle}</span>
</a>
<a class="version-pill" href="/versions/" aria-label={`Docs version ${version} — see all versions`}>
	{version}
</a>

<style>
	.site-title {
		align-items: center;
		font-size: var(--sl-text-h4);
		font-weight: 600;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.site-title span {
		overflow: hidden;
	}
	.version-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin-inline-start: calc(var(--sl-nav-gap) / 2);
		padding: 0.125rem 0.5rem;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 9999px;
		font-size: var(--sl-text-xs);
		font-weight: 500;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	.version-pill:hover,
	.version-pill:focus-visible {
		border-color: var(--sl-color-text-accent);
		color: var(--sl-color-text-accent);
	}
</style>
