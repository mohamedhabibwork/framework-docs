---
/**
 * One cell of the landing feature grid. The icon is a small inline SVG set
 * chosen to read at 16px; `stroke="currentColor"` keeps it theme-aware.
 */
interface Props {
  icon: 'bolt' | 'table' | 'shield' | 'flow' | 'key' | 'schema';
  title: string;
}

const { icon, title } = Astro.props;

const paths: Record<Props['icon'], string> = {
  bolt: 'M8.5 2 4 9h3.2L7 14l4.6-7.2H8.3L8.5 2Z',
  table: 'M2.5 4.2h11v7.6h-11zM2.5 7.4h11M6.4 4.2v7.6',
  shield: 'M8 2.2 13 4v4.1c0 2.6-2 4.6-5 5.7-3-1.1-5-3.1-5-5.7V4l5-1.8ZM6 8l1.4 1.4L10.2 6.6',
  flow: 'M3 4h4v3H3zM9 9h4v3H9zM5 7v3.5h4',
  key: 'M9.8 2.6a3.4 3.4 0 1 0-1 4.9l.5.5H11v1.4h1.4V11H14v1.4h-3.1L7.2 8.7a3.4 3.4 0 0 1 2.6-6.1Z',
  schema: 'M4 2.6h8v3H4zM4 10.4h8v3H4zM8 5.6v4.8M5.6 8h4.8',
};
---

<article class="feature">
	<span class="feature-icon" aria-hidden="true">
		<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
			<path d={paths[icon]}></path>
		</svg>
	</span>
	<h3>{title}</h3>
	<p><slot /></p>
</article>
